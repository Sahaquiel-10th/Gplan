# 万里牛 AI Skill（仅服务端使用，密钥不要放到前端）
WANLINIU_APP_KEY=
WANLINIU_APP_SECRET=
# 生产环境填写已安装的 hupun-api-cli 绝对路径。
HUPUN_API_CLI_PATH=
HUPUN_API_HOST=https://open-api.hupun.com
HUPUN_API_TIMEOUT_SECONDS=45
HUPUN_AI_SKILL_MAX_CALLS=3
HUPUN_AI_SKILL_RESULT_MAX_CHARS=30000

# 万里牛经营数据同步（独立落到 gplan_data；可复用同一个 RDS 实例）
DATA_DB_PROVIDER=mysql
DATA_MYSQL_HOST=rm-example.mysql.rds.aliyuncs.com
DATA_MYSQL_PORT=3306
DATA_MYSQL_USER=gplan_data_app
DATA_MYSQL_PASSWORD=please-change-this
DATA_MYSQL_DATABASE=gplan_data
DATA_MYSQL_CONNECTION_LIMIT=5
# 多企业部署时显式填写；单企业环境默认使用首个管理员的 companyId。
WANLINIU_COMPANY_ID=company_default
# 建议先手动跑通首轮，再开启定时任务。
WANLINIU_SYNC_ENABLED=false
# 每天北京时间固定执行；进程重启后仍会对准下一个固定时刻。
WANLINIU_SYNC_DAILY_TIME=03:00
WANLINIU_INITIAL_LOOKBACK_DAYS=30
WANLINIU_PRODUCT_INITIAL_START=2000-01-01T00:00:00+08:00
WANLINIU_SYNC_OVERLAP_MINUTES=10
# 销售出库和采购入库按时间分片，单个分片成功后立即保存断点。
WANLINIU_SYNC_SLICE_HOURS=24
WANLINIU_SYNC_MAX_PAGES=5000
WANLINIU_API_RETRIES=2

# 联网搜索（服务端调用，密钥不要放到前端）
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_MS=15000

# 单次最多 4 个附件；默认每个 10MB
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_MAX_EXTRACTED_CHARS=30000
ATTACHMENT_CONTEXT_CHARS=24000

BAILIAN_API_KEY=
BAILIAN_WORKSPACE_ID=
BAILIAN_COMPANY_KB_ID=
BAILIAN_MEMORY_ID=
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
